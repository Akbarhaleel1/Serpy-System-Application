{
  "name": "serpy-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop shell for the SerpY ERP client",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/sign-electron.js",
    "copy-client": "node copy-client.js",
    "dev": "npm run copy-client && electron .",
    "dist": "npm run copy-client && electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-serve": "^1.3.0"
  },
  "build": {
    "appId": "com.printarts.serpy.desktop",
    "productName": "SerpY",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "afterSign": "scripts/afterSign.js",
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
