{
  "name": "serpy-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop shell for the SerpY ERP client",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/sign-electron.js",
    "copy-client": "node copy-client.js",
    "dev": "npm run copy-client && electron .",
    "dist": "npm run copy-client && electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-serve": "^1.3.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.printarts.serpy.desktop",
    "productName": "SerpY",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend-runner.js",
      "license-store.js",
      "updater.js",
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.env",
          "!.env.*",
          "!**/*.md",
          "!**/*.bat",
          "!test*",
          "!check*",
          "!fix-settings.js",
          "!force-settings.js",
          "!setup-settings.js",
          "!install-chromium.js",
          "!seeders/**",
          "!node_modules/puppeteer/**",
          "!node_modules/puppeteer-core/**",
          "!node_modules/.cache/**",
          "!node_modules/**/test/**",
          "!node_modules/**/*.md",
          "!**/*.map"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Akbarhaleel1",
        "repo": "Serpy-System-Application"
      }
    ],
    "afterPack": "scripts/afterPack.js",
    "afterSign": "scripts/afterSign.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
